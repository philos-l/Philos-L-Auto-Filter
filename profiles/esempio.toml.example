# Parole chiave da cercare nelle email (non fa differenza maiuscole/minuscole).
# Vengono cercate come parole intere: "logic" non trova "phenomenological".
# Basta che la mail ne contenga una. Per combinarle usa AND, OR, NOT (in
# maiuscolo) e le parentesi, ad esempio:
#     "(phd OR fellowship) AND (metaphysics OR logic)",
keywords = [
    "phd",
    "postdoc",
]

# ── Telegram ────────────────────────────────────────────────────────────────
# Bot: Philos-L Notification Bot → https://t.me/philos_l_notification_bot
#
# Per ottenere il chat_id segui il README
telegram_chat_id = "IL_TUO_CHAT_ID"
